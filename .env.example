# ============================================================================
# Environment variable template — copy this file to `.env` and fill in values
# ============================================================================
#   cp .env.example .env         # macOS / Linux
#   copy .env.example .env       # Windows
#
# NEVER commit a populated `.env` to git. The repo's `.gitignore` should
# already exclude it; verify with `git check-ignore .env` (should print
# the path). The empty `.env.example` IS safe to commit — it has no secrets.
# ============================================================================

# ---------- OpenAI (used by every LangGraph backend & most notebooks) ----------
OPENAI_API_KEY=""

# ---------- LangSmith tracing (optional, set to "true" to enable) ----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT='https://api.smith.langchain.com'
LANGCHAIN_API_KEY=''
LANGCHAIN_PROJECT=''

# ---------- Google Custom Search (optional, used by MCP google-search server) ----------
# Get a key at https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

# ---------- GitHub (optional, used by MCP github server) ----------
# Generate a personal access token at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=""

# ---------- Tavily search (used by AI-Agent-Plans/tavily_test.ipynb) ----------
# Get a free key at https://tavily.com/
TAVILY_API_KEY=""

# ---------- Airbnb (optional, used by MCP airbnb server) ----------
AIRBNB_API_KEY=""
